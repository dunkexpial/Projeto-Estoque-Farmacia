<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.paint.Color?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="Controller"
            style="-fx-background-color: #f5f5f5;"
            stylesheets="@theme.css">

    <!-- Top bar (categorias estilo Kabum) -->
    <top>
        <HBox spacing="10" alignment="CENTER_LEFT"
              style="-fx-background-color: white; -fx-padding: 10; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
            <Label text="💊 Medicamentos" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Buscar:"/>
            <TextField fx:id="searchField" promptText="Digite o nome do remédio" prefWidth="200"/>
            <Label text="Ordenar:"/>
            <ComboBox fx:id="sortCombo" prefWidth="140"/>
            <Label text="Filtrar:"/>
            <ComboBox fx:id="filterCombo" prefWidth="140"/>
            <Label fx:id="totalLabel" text="Total: 0"
                   style="-fx-font-weight: bold; -fx-text-fill: #FF6600; -fx-font-size: 14px;"/>
        </HBox>
    </top>

    <!-- Center: grid estilo Kabum com cartões -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background: transparent;">
            <TilePane fx:id="gridPane" hgap="15" vgap="15" prefColumns="4"
                      style="-fx-padding: 20;"
                      TilePane.alignment="TOP_CENTER">
            </TilePane>
        </ScrollPane>
    </center>

    <!-- Right panel: formulário lateral -->
    <right>
        <VBox spacing="12" alignment="TOP_CENTER"
              style="-fx-background-color: white; -fx-background-radius: 0; -fx-padding: 15;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8, 0, 0, 2);">
            <Label text="+ Novo Medicamento"
                   style="-fx-font-size: 16px; -fx-text-fill: #FF6600; -fx-font-weight: bold;"/>
            <TextField fx:id="nomeField" promptText="Nome do Remédio" />
            <TextField fx:id="batchField" promptText="Lote do Remédio" />
            <TextField fx:id="qtdField" promptText="Quantidade"/>
            <TextField fx:id="validadeField" promptText="Validade (dd/mm/yyyy)"/>
            <!-- New field for per-medicine low stock alert -->
            <TextField fx:id="thresholdField" promptText="Alerta mínimo (estoque)" />

            <Button text="✔ Adicionar / Salvar"
                    onAction="#adicionarMedicamento"
                    style="-fx-background-color: #FF6600; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;"/>
            <Button fx:id="editarSelecionadoBtn" text="✎ Editar Selecionado"
                    style="-fx-background-color: #FFA500; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;"/>
            <Button fx:id="excluirSelecionadoBtn" text="🗑 Excluir Selecionado"
                    style="-fx-background-color: #FF0000; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;"/>
        </VBox>
    </right>
</BorderPane>
